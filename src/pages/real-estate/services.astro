---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Services | Real Estate — VanHeight"
  description="Real estate services coming soon."
>
  <Header />
  <main class="min-h-screen flex items-center justify-center" style="background: #0C0C0C; padding-top: 120px;">
    <div class="text-center">
      <p class="section-label mb-4">Coming Soon</p>
      <h1 class="text-5xl md:text-6xl font-light" style="font-family: 'Playfair Display', serif; color: #F5F5F5;">
        Services
      </h1>
    </div>
  </main>
  <Footer />
</Layout>
