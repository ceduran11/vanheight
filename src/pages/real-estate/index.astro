---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Houston Real Estate Investment | VanHeight"
  description="A strategic overview of the financial, economic, and tax advantages of investing in Houston real estate — backed by VanHeight's renovation expertise."
  sidebarLayout={true}
>
  <Header />
  <div class="re-page">

  <!-- Hero Section with Houston Background -->
  <div class="relative overflow-hidden flex flex-col justify-end" style="min-height: 680px;">
    <img
      src="https://images.unsplash.com/photo-1530089711124-9ca31fb9e863?w=1800&q=80"
      alt="Houston Downtown Skyline"
      class="absolute inset-0 w-full h-full object-cover hero-pan"
      loading="eager"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(12,12,12,0.97) 0%, rgba(12,12,12,0.6) 50%, rgba(12,12,12,0.25) 100%);"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-20 pt-40 w-full">
      <p class="section-label mb-3" data-i18n="flipHero.label">Fix & Flip Concierge · Houston, TX</p>
      <h1 class="text-5xl md:text-7xl font-light leading-tight mb-4" style="font-family: 'Playfair Display', serif;">
        <span data-i18n="flipHero.title">Tu capital trabaja.</span><br />
        <span class="text-gold italic" data-i18n="flipHero.titleSpan">Nosotros hacemos el resto.</span>
      </h1>
      <p class="text-white/60 text-lg max-w-2xl mb-8" data-i18n="flipHero.subtext">
        Encontramos la propiedad, coordinamos la remodelación y la vendemos por ti. Servicio completo de fix & flip para inversionistas que tienen el capital pero no el tiempo.
      </p>

      <div class="flex flex-wrap gap-4 mb-12">
        <a href="https://flipper-tx.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn-gold" data-i18n="flipHero.cta1">
          Calcular mi ROI →
        </a>
        <a href="/real-estate/services" class="btn-outline" data-i18n="flipHero.cta2">
          Ver cómo funciona
        </a>
      </div>

      <!-- Key Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px" style="background: rgba(42,42,42,0.6); max-width: 640px;">
        {[
          { numberKey: 'flipHero.stat1Value', number: '$180K', labelKey: 'flipHero.stat1Label', label: 'Compra Típica' },
          { numberKey: 'flipHero.stat2Value', number: '$40K+', labelKey: 'flipHero.stat2Label', label: 'Ganancia Promedio' },
          { numberKey: 'flipHero.stat3Value', number: '5 meses', labelKey: 'flipHero.stat3Label', label: 'Ciclo Completo' },
          { numberKey: 'flipHero.stat4Value', number: '$0', labelKey: 'flipHero.stat4Label', label: 'Tu Tiempo Invertido' },
        ].map(s => (
          <div class="p-6 text-center" style="background: rgba(20,20,20,0.7); backdrop-filter: blur(8px);">
            <p class="text-2xl font-light text-gold mb-1" style="font-family: 'Playfair Display', serif;" data-i18n={s.numberKey}>{s.number}</p>
            <p class="text-xs text-muted-custom uppercase tracking-widest" data-i18n={s.labelKey}>{s.label}</p>
          </div>
        ))}
      </div>
      <p class="text-white/30 text-xs mt-4" data-i18n="flipHero.statsNote">
        Economía típica de un flip en Houston (ejemplo del modelo)
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-12" style="background: #0C0C0C;">
    <div class="flex flex-col gap-8">

      <!-- Three Phases -->
      <div class="fade-in">
        <p class="section-label mb-3" data-i18n="phases.label">Cómo Funciona</p>
        <h2 class="text-4xl md:text-5xl font-light mb-10" style="font-family: 'Playfair Display', serif;" data-i18n="phases.title">
          Tres fases, un solo socio.
        </h2>
        <div class="flex flex-col gap-px" style="background: rgba(42,42,42,0.6);">
          {[
            { num: '01', titleKey: 'phases.step1Title', title: 'Encontramos', descKey: 'phases.step1Desc', desc: 'Nosotros publicamos y te enviamos propiedades de wholesaler y HAR que sí dan los números. Cada propiedad pasa por FlipperTX —nuestro análisis de MAO y ROI— antes que la veas. Negociamos y cerramos como tu realtor.', feeKey: 'phases.step1Fee', fee: 'Descuento de hasta el 1% del precio de compra (aplican condiciones)' },
            { num: '02', titleKey: 'phases.step2Title', title: 'Remodelamos', descKey: 'phases.step2Desc', desc: 'Diseño, cotizaciones, cuadrillas propias y seguimiento de gastos semana a semana. Tú apruebas, nosotros ejecutamos. Aquí está nuestra ventaja real: somos la empresa de remodelación, no un intermediario que subcontrata.', feeKey: 'phases.step2Fee', fee: 'Desde $400/mes + margen de obra (transparente)' },
            { num: '03', titleKey: 'phases.step3Title', title: 'Vendemos', descKey: 'phases.step3Desc', desc: 'Staging, fotografía profesional, listing en HAR, open house y negociación de la venta. Comisión preferencial para clientes del paquete completo.', feeKey: 'phases.step3Fee', fee: 'Comisión de venta preferencial' },
          ].map(step => (
            <div class="p-10" style="background: #141414;">
              <div class="flex items-start gap-6">
                <div class="w-10 h-10 flex-shrink-0 border border-gold flex items-center justify-center text-gold text-sm font-bold">{step.num}</div>
                <div>
                  <h3 class="text-2xl font-light mb-3" style="font-family: 'Playfair Display', serif;" data-i18n={step.titleKey}>{step.title}</h3>
                  <p class="text-white/60 leading-relaxed mb-4 max-w-3xl" data-i18n={step.descKey}>{step.desc}</p>
                  <div class="flex items-center gap-3">
                    <span class="inline-block w-1 h-4" style="background: #4ade80;"></span>
                    <p class="text-sm text-white/50" data-i18n={step.feeKey}>{step.fee}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- FlipperTX -->
      <div id="flippertx" class="fade-in border-2 border-gold p-10" style="background: #141414;">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-10 h-10 bg-gold flex items-center justify-center text-black text-sm font-bold">TX</div>
          <h2 class="text-2xl font-light" style="font-family: 'Playfair Display', serif;" data-i18n="realEstate.ftxTitle">FlipperTX — Your Operational Edge</h2>
        </div>
        <p class="text-white/60 text-sm leading-relaxed mb-8 max-w-3xl" data-i18n="realEstate.ftxDesc">
          FlipperTX is the operational platform built to support Houston-area real estate investors at every stage — from deal analysis to renovation management.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { title: 'Deal Analysis', text: 'Run MAO calculations, repair cost estimates, and ROI projections.', tk: 'realEstate.ftx1t', dk: 'realEstate.ftx1d' },
            { title: 'Renovation Tracking', text: 'Manage contractor scopes, timelines, and budgets in one place.', tk: 'realEstate.ftx2t', dk: 'realEstate.ftx2d' },
            { title: 'Portfolio Dashboard', text: 'Track all your Houston properties from a single dashboard.', tk: 'realEstate.ftx3t', dk: 'realEstate.ftx3d' },
          ].map(item => (
            <div class="p-6 border border-subtle" style="background: #0C0C0C;">
              <div class="w-8 h-1 bg-gold mb-4"></div>
              <h3 class="text-white font-semibold mb-2" data-i18n={item.tk}>{item.title}</h3>
              <p class="text-white/50 text-sm leading-relaxed" data-i18n={item.dk}>{item.text}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 pt-8 border-t border-subtle flex flex-col md:flex-row md:items-center justify-between gap-4">
          <p class="text-white/50 text-sm" data-i18n="realEstate.ftxTagline">
            VanHeight + FlipperTX — renovation expertise meets investment intelligence.
          </p>
          <a
            href="https://flipper-tx.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-gold shrink-0"
            style="font-size: 0.75rem; padding: 0.75rem 1.75rem;"
            data-i18n="realEstate.ftxBtn"
          >
            Launch FlipperTX →
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Custom Real Estate CTA -->
  <section class="py-12 md:py-16 relative overflow-hidden" style="background: #0C0C0C;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <div class="fade-in">
        <p class="section-label mb-6" data-i18n="reCta.label">Empieza con los números, no con el compromiso</p>
        <h2
          class="text-4xl md:text-6xl font-light leading-tight mb-6"
          style="font-family: 'Playfair Display', serif;"
        >
          <span data-i18n="reCta.title">Empieza con los números,</span><br />
          <span class="text-gold italic" data-i18n="reCta.titleSpan">no con el compromiso.</span>
        </h2>
        <p class="text-white/60 text-lg mb-10 leading-relaxed" data-i18n="reCta.subtext">
          Cuéntanos tu presupuesto y te corremos el análisis de un deal real, gratis. Sin compromiso. Si los números te convencen, hablamos del siguiente paso.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <button id="open-appt-modal" class="btn-gold" style="padding: 1rem 2.5rem;" data-i18n="reCta.button">
            Solicitar mi análisis gratis →
          </button>
          <a href="tel:+13467172406" class="btn-outline" style="padding: 1rem 2.5rem;">
            (346) 717-2406
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 pb-24">
    <div class="flex flex-col gap-8">

      <!-- Legal Disclosure -->
      <div class="fade-in border border-subtle p-8" style="background: #0a0a0a;">
        <div class="flex items-start gap-4">
          <div class="shrink-0 mt-1">
            <svg class="w-5 h-5 text-gold/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
          </div>
          <div>
            <p class="text-gold/80 text-xs font-semibold tracking-widest uppercase mb-3" data-i18n="realEstate.discTitle">Legal Disclosure & Disclaimer</p>
            <p class="text-white/40 text-xs leading-relaxed mb-3" data-i18n="realEstate.disc1">
              The information on this page is provided strictly for informational purposes only. It does not constitute financial, investment, tax, or legal advice of any kind.
            </p>
            <p class="text-white/40 text-xs leading-relaxed mb-3" data-i18n="realEstate.disc2">
              FlipperTX is referenced as an operational support tool. No representation is made that FlipperTX guarantees any specific investment outcome. All real estate investments involve risk, including possible loss of principal.
            </p>
            <p class="text-white/40 text-xs leading-relaxed mb-3" data-i18n="realEstate.disc3">
              Cap rates, yield projections, and market statistics are general estimates based on publicly available data and are subject to change.
            </p>
            <p class="text-white/40 text-xs leading-relaxed" data-i18n="realEstate.disc4">
              Tax information is for general informational purposes only. Always consult a qualified CPA, tax attorney, or financial advisor before making any investment or tax decision. VanHeight and FlipperTX disclaim any liability arising from reliance on information presented on this page.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  </div>
  <Footer />

  <!-- Appointment Modal -->
  <div id="appt-modal" class="re-page fixed inset-0 z-[200] hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(6px);">
    <div class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto border border-subtle" style="background: #141414;">

      <!-- Modal Header -->
      <div class="flex items-center justify-between px-8 py-6 border-b border-subtle">
        <div>
          <p class="text-gold text-xs tracking-widest uppercase mb-1" data-i18n="appt.label">Real Estate Consultation</p>
          <h3 class="text-xl font-light" style="font-family: 'Playfair Display', serif;" data-i18n="appt.title">Request an Appointment</h3>
        </div>
        <button id="close-appt-modal" type="button" class="text-white/40 hover:text-white transition-colors text-2xl leading-none">✕</button>
      </div>

      <!-- Form -->
      <div class="px-8 py-8">
        <form id="appt-form" class="flex flex-col gap-5" novalidate>
          <input type="hidden" name="access_key" value="fe79e33d-fcc7-4eb7-964c-321ff285446a" />
          <input type="hidden" name="subject" value="Nueva Cita Real Estate - VanHeight" />
          <input type="hidden" name="from_name" value="VanHeight Real Estate" />
          <input type="hidden" name="cc" value="benjamineric@hotmail.com" />
          <input type="checkbox" name="botcheck" style="display:none;" />

          <!-- Name -->
          <div>
            <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.fullName">Full Name *</label>
            <input type="text" name="fullName" required placeholder="John Smith"
              class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors placeholder-muted-custom" />
          </div>

          <!-- Contact row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.phone">Phone</label>
              <input type="tel" name="phone" placeholder="(832) 000-0000"
                class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors placeholder-muted-custom" />
            </div>
            <div>
              <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.email">Email</label>
              <input type="email" name="email" placeholder="john@example.com"
                class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors placeholder-muted-custom" />
            </div>
          </div>

          <p class="text-xs text-muted-custom -mt-2">* At least phone or email is required.</p>

          <!-- Interest type -->
          <div>
            <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.interestLabel">Type of Interest *</label>
            <select name="interest" required
              class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors"
              style="background: #141414;">
              <option value="" disabled selected data-i18n="appt.selectInterest">Select an option</option>
              <option value="Investment Property" data-i18n="appt.optInvestment">Investment Property</option>
              <option value="Primary Residence" data-i18n="appt.optPrimary">Primary Residence</option>
              <option value="Both" data-i18n="appt.optBoth">Both</option>
            </select>
          </div>

          <!-- Budget & Timeline -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.budgetLabel">Budget Range</label>
              <select name="budget"
                class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors"
                style="background: #141414;">
                <option value="" disabled selected data-i18n="appt.selectBudget">Select range</option>
                <option value="Under $200K">Under $200K</option>
                <option value="$200K–$400K">$200K – $400K</option>
                <option value="$400K–$600K">$400K – $600K</option>
                <option value="$600K–$1M">$600K – $1M</option>
                <option value="$1M+">$1M+</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.timelineLabel">Purchase Timeline</label>
              <select name="timeline"
                class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors"
                style="background: #141414;">
                <option value="" disabled selected data-i18n="appt.selectTimeline">Select timeline</option>
                <option value="ASAP" data-i18n="appt.timelineAsap">ASAP</option>
                <option value="1–3 months" data-i18n="appt.timeline1to3">1–3 months</option>
                <option value="3–6 months" data-i18n="appt.timeline3to6">3–6 months</option>
                <option value="6+ months" data-i18n="appt.timeline6plus">6+ months</option>
              </select>
            </div>
          </div>

          <!-- Areas -->
          <div>
            <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.areasLabel">Preferred Areas / Zip Codes</label>
            <input type="text" name="areas" placeholder="e.g. The Woodlands, Katy, Heights, 77008"
              class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors placeholder-muted-custom" />
          </div>

          <!-- Notes -->
          <div>
            <label class="block text-xs text-muted-custom uppercase tracking-widest mb-2" data-i18n="appt.notesLabel">Additional Notes</label>
            <textarea name="notes" rows="3"
              class="w-full bg-transparent border border-subtle px-4 py-3 text-sm text-white focus:border-gold focus:outline-none transition-colors resize-none placeholder-muted-custom"
              placeholder="Any additional details about what you're looking for..."
              data-i18n-placeholder="appt.notesPlaceholder"></textarea>
          </div>

          <p id="appt-error" class="text-red-400 text-xs hidden" data-i18n="appt.errorMsg">Please fill in all required fields.</p>

          <div class="flex items-center justify-between pt-2">
            <p class="text-xs text-muted-custom" data-i18n="appt.note">We'll contact you within 24 hours to confirm.</p>
            <button type="submit" id="appt-submit" class="btn-gold" style="padding: 0.875rem 2rem;" data-i18n="appt.submit">
              Send Request
            </button>
          </div>
        </form>

        <!-- Success -->
        <div id="appt-success" class="hidden text-center py-10">
          <div class="w-14 h-14 border border-gold flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <h4 class="text-xl font-light mb-2" style="font-family: 'Playfair Display', serif;" data-i18n="appt.successTitle">Appointment Requested!</h4>
          <p class="text-muted-custom text-sm" data-i18n="appt.successText">Our team will reach out within 24 hours to confirm your consultation.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  @keyframes heroPan {
    0%   { transform: scale(1) translate(0, 0); }
    50%  { transform: scale(1.08) translate(-1.5%, -1%); }
    100% { transform: scale(1) translate(0, 0); }
  }
  .hero-pan {
    animation: heroPan 30s ease-in-out infinite;
  }

  .re-page .text-gold          { color: #4ade80 !important; }
  .re-page .bg-gold            { background-color: #4ade80 !important; }
  .re-page .border-gold        { border-color: #4ade80 !important; }
  .re-page .text-gold\/60      { color: rgba(74,222,128,0.6) !important; }
  .re-page .text-gold\/80      { color: rgba(74,222,128,0.8) !important; }

  .re-page .btn-gold {
    background: #4ade80 !important;
    color: #000 !important;
    border: none !important;
    text-shadow: none !important;
  }
  .re-page .btn-gold:hover {
    background: #6ee7b7 !important;
  }

  .re-page .btn-outline {
    border-color: #4ade80 !important;
    color: #4ade80 !important;
  }
  .re-page .btn-outline:hover {
    background: #4ade80 !important;
    color: #000 !important;
  }

  .re-page .focus\:border-gold:focus {
    border-color: #4ade80 !important;
  }

  .re-page .section-label {
    color: #4ade80 !important;
  }
</style>

<script>
  const modal = document.getElementById('appt-modal');
  const openBtn = document.getElementById('open-appt-modal');
  const closeBtn = document.getElementById('close-appt-modal');
  const form = document.getElementById('appt-form') as HTMLFormElement;
  const submitBtn = document.getElementById('appt-submit') as HTMLButtonElement;
  const successDiv = document.getElementById('appt-success');
  const errorMsg = document.getElementById('appt-error');

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', (e) => { e.preventDefault(); openModal(); });
  closeBtn?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); closeModal(); });
  modal?.addEventListener('click', (e) => { e.stopPropagation(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');

    const required = form.querySelectorAll('[required]') as NodeListOf<HTMLInputElement | HTMLSelectElement>;
    let valid = true;
    required.forEach(f => {
      f.style.borderColor = '';
      if (!f.value.trim()) { f.style.borderColor = '#E53E3E'; valid = false; }
    });

    // Phone OR Email — at least one required
    const phoneField = form.querySelector('[name="phone"]') as HTMLInputElement;
    const emailField = form.querySelector('[name="email"]') as HTMLInputElement;
    phoneField.style.borderColor = '';
    emailField.style.borderColor = '';
    if (!phoneField.value.trim() && !emailField.value.trim()) {
      phoneField.style.borderColor = '#E53E3E';
      emailField.style.borderColor = '#E53E3E';
      valid = false;
    }

    if (!valid) { errorMsg?.classList.remove('hidden'); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = '...';

    const data = new FormData(form);
    const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });

    if (res.ok) {
      form.style.display = 'none';
      successDiv?.classList.remove('hidden');
    } else {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Request';
      errorMsg?.classList.remove('hidden');
    }
  });
</script>
