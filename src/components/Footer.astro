        </div>

        <!-- Services -->
        <div>
          <h4 class="text-white font-semibold text-sm tracking-widest uppercase mb-6" data-i18n="footer.servicesTitle">Services</h4>
          <ul class="flex flex-col gap-3">
            {services.map((s) => (
