---
const services = [
  { label: 'Kitchen Remodeling', href: '/services/kitchens', key: 'footer.kitchen' },
  { label: 'Bathroom Remodeling', href: '/services/bathrooms', key: 'footer.bathroom' },
  { label: 'Flooring', href: '/services/flooring', key: 'footer.flooring' },
  { label: 'Interior & Exterior Painting', href: '/services/painting', key: 'footer.painting' },
  { label: 'Additions', href: '/services/additions', key: 'footer.additions' },
  { label: 'Custom Carpentry', href: '/services/carpentry', key: 'footer.carpentry' },
];

const links = [
  { label: 'Home', href: '/', key: 'footer.navHome' },
  { label: 'Services', href: '/services', key: 'footer.navServices' },
  { label: 'Gallery', href: '/gallery', key: 'footer.navGallery' },
  { label: 'About', href: '/about', key: 'footer.navAbout' },
  { label: 'Contact', href: '/contact', key: 'footer.navContact' },
];

const reServices = [
  { label: 'Deal Access', href: '/real-estate/services' },
  { label: 'Build Track', href: '/real-estate/services' },
  { label: 'Sale Ready', href: '/real-estate/services' },
];

const reLinks = [
  { label: 'Home', href: '/real-estate', key: 'footer.navHome' },
  { label: 'Services', href: '/real-estate/services', key: 'footer.navServices' },
  { label: 'Gallery', href: '/real-estate/gallery', key: 'footer.navGallery' },
  { label: 'About', href: '/real-estate/about', key: 'footer.navAbout' },
  { label: 'Contact', href: '/real-estate/contact', key: 'footer.navContact' },
];

const rawPath = Astro.url.pathname;
const currentPath = rawPath.length > 1 ? rawPath.replace(/\/$/, '') : rawPath;
const isRealEstate = currentPath.startsWith('/real-estate');
---

{isRealEstate ? (
  <footer style="background: #080808; border-top: 1px solid #2A2A2A;">
    <div class="max-w-7xl mx-auto px-6 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">

        <!-- Brand -->
        <div class="lg:col-span-1">
          <a href="/real-estate" class="flex flex-col items-start mb-6">
            <img src="/images/logo-re.png" alt="VanHeight Real Estate" style="height: 70px; width: auto; display: block;" />
            <div class="flex flex-col leading-none mt-2">
              <span style="font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase; line-height: 1.1;">VanHeight</span>
              <span class="flex items-center gap-2 mt-1">
                <span style="display: inline-block; width: 14px; height: 1px; background: #4ade80;"></span>
                <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #4ade80; text-transform: uppercase;">Real Estate</span>
                <span style="display: inline-block; width: 14px; height: 1px; background: #4ade80;"></span>
              </span>
            </div>
          </a>
          <p class="text-muted-custom text-sm leading-relaxed mb-6" data-i18n="reFooter.tagline">
            Fix & Flip Concierge para inversionistas de real estate en Houston, TX. Encontramos, remodelamos y vendemos — bajo un solo techo.
          </p>
          <!-- Social -->
          <div class="flex gap-4">
            <a href="https://www.facebook.com/vanheight.cons/" target="_blank" rel="noopener" class="text-muted-custom hover:text-gold transition-colors text-sm" aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
            </a>
            <a href="#" target="_blank" rel="noopener" class="text-muted-custom hover:text-gold transition-colors" aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/></svg>
            </a>
          </div>
        </div>

        <!-- Services -->
        <div>
          <h4 class="text-white font-semibold text-sm tracking-widest uppercase mb-6" data-i18n="reFooter.servicesTitle">Servicios</h4>
          <ul class="flex flex-col gap-3">
            {reServices.map((s) => (
              <li>
                <a href={s.href} class="text-muted-custom text-sm re-footer-link transition-colors">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Links -->
        <div>
          <h4 class="text-white font-semibold text-sm tracking-widest uppercase mb-6" data-i18n="reFooter.companyTitle">Compañía</h4>
          <ul class="flex flex-col gap-3">
            {reLinks.map((l) => (
              <li>
                <a href={l.href} class="text-muted-custom text-sm re-footer-link transition-colors" data-i18n={l.key}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="text-white font-semibold text-sm tracking-widest uppercase mb-6" data-i18n="reFooter.contactTitle">Contacto</h4>
          <ul class="flex flex-col gap-4">
            <li>
              <p class="text-xs text-muted-custom uppercase tracking-widest mb-1" data-i18n="reFooter.phoneLabel">Teléfono</p>
              <a href="tel:+13467172406" class="text-sm text-white/80 re-footer-link transition-colors">
                (346) 717-2406
              </a>
            </li>
            <li>
              <p class="text-xs text-muted-custom uppercase tracking-widest mb-1" data-i18n="reFooter.emailLabel">Email</p>
              <a href="mailto:info@vanheight.com" class="text-sm text-white/80 re-footer-link transition-colors">
                info@vanheight.com
              </a>
            </li>
            <li>
              <p class="text-xs text-muted-custom uppercase tracking-widest mb-1" data-i18n="reFooter.areaLabel">Área</p>
              <p class="text-sm text-white/80" data-i18n="reFooter.areaText">Houston & Greater Houston, TX</p>
            </li>
            <li class="pt-2">
              <a href="/real-estate/contact" class="re-footer-cta" style="font-size: 0.75rem; padding: 0.75rem 1.5rem;" data-i18n="reFooter.ctaButton">
                Solicitar Consulta
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="border-t border-subtle pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-muted-custom text-xs">
          © {new Date().getFullYear()} <span data-i18n="reFooter.copyrightText">VanHeight Real Estate. All rights reserved. Houston, TX.</span>
        </p>
        <div class="flex gap-6">
          <a href="/privacy" class="text-muted-custom text-xs hover:text-white transition-colors" data-i18n="footer.privacy">Privacy Policy</a>
          <a href="/terms" class="text-muted-custom text-xs hover:text-white transition-colors" data-i18n="footer.terms">Terms of Service</a>
        </div>
      </div>
    </div>

    <style>
      .re-footer-link:hover { color: #4ade80 !important; }
      .re-footer-cta {
        display: inline-block;
        background: #4ade80;
        color: #000;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        border-radius: 50px;
        transition: all 0.25s ease;
      }
      .re-footer-cta:hover {
        background: #6ee7b7;
      }
    </style>
  </footer>
) : (
  <footer style="background: #080808; border-top: 1px solid #2A2A2A;">
    <div class="max-w-7xl mx-auto px-6 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">

        <!-- Brand -->
