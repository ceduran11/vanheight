            <img src="/images/logo.png" alt="VanHeight" style="height: 80px; width: auto; display: block;" />
            <div class="flex flex-col leading-none" style="margin-left: -22px;">
              <span style="font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase; line-height: 1.1;">VanHeight</span>
              <span class="flex items-center gap-2 mt-1">
                <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
                <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
