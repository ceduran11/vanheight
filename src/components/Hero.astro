---
---

<section
  id="hero"
  class="relative min-h-screen flex items-start overflow-hidden"
  style="background: #0C0C0C;"
>
  <!-- Background image placeholder (replace src with real photo) -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1800&q=80"
      alt="Luxury home exterior"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <!-- Dark gradient overlay -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to top, rgba(12,12,12,0.97) 0%, rgba(12,12,12,0.55) 50%, rgba(12,12,12,0.2) 100%);"
    ></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 pb-24 md:pb-32 w-full" style="padding-top: 160px;">

    <!-- Label -->
    <p class="section-label mb-6 fade-in" data-i18n="hero.label">The Woodlands, Texas</p>

    <!-- Headline -->
    <h1
      class="fade-in text-5xl md:text-7xl lg:text-8xl font-light leading-none tracking-tight mb-6"
      style="font-family: 'Playfair Display', serif; transition-delay: 0.1s;"
    >
      <span data-i18n="hero.headline1">Homes Crafted</span><br />
      <span class="text-gold italic" data-i18n="hero.headline2">With Purpose.</span>
    </h1>

    <!-- Subtext -->
    <p
      class="fade-in text-white/60 text-lg md:text-xl max-w-xl mb-10 leading-relaxed"
      style="transition-delay: 0.2s;"
      data-i18n="hero.subtext"
    >
      Premium remodeling for kitchens, bathrooms, flooring, painting,
      additions & custom carpentry — built to last a lifetime.
    </p>

    <!-- CTAs -->
    <div class="fade-in flex flex-wrap gap-4" style="transition-delay: 0.3s;">
      <a href="/contact" class="btn-gold" data-i18n="hero.cta1">Get a Free Quote</a>
      <a href="/gallery" class="btn-outline" data-i18n="hero.cta2">View Our Work</a>
    </div>

    <!-- Stats bar -->
    <div
      class="fade-in mt-16 md:mt-20 grid grid-cols-3 border-t border-subtle max-w-lg"
      style="transition-delay: 0.4s; padding-top: 20px;"
    >
      <div class="pr-8 border-r border-subtle">
        <p class="text-2xl md:text-3xl font-semibold text-gold" style="font-family: 'Playfair Display', serif;">20+</p>
        <p class="text-xs text-muted-custom uppercase tracking-widest" style="margin-top: 4px;" data-i18n="hero.stat1">Years Experience</p>
      </div>
      <div class="px-8 border-r border-subtle">
        <p class="text-2xl md:text-3xl font-semibold text-gold" style="font-family: 'Playfair Display', serif;">500+</p>
        <p class="text-xs text-muted-custom uppercase tracking-widest" style="margin-top: 4px;" data-i18n="hero.stat2">Projects Done</p>
      </div>
      <div class="pl-8">
        <p class="text-2xl md:text-3xl font-semibold text-gold" style="font-family: 'Playfair Display', serif;">100%</p>
        <p class="text-xs text-muted-custom uppercase tracking-widest" style="margin-top: 4px;" data-i18n="hero.stat3">Satisfaction</p>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 right-8 z-10 hidden md:flex flex-col items-center gap-2">
    <p class="text-white/30 text-xs tracking-widest uppercase" style="writing-mode: vertical-rl;">
      Scroll
    </p>
    <div class="w-px h-12 bg-white/20 relative overflow-hidden">
      <div class="w-full bg-gold absolute top-0 animate-[scroll_1.8s_ease-in-out_infinite]" style="height: 40%; animation: scrollLine 1.8s ease-in-out infinite;"></div>
    </div>
  </div>
</section>

<style>
  @keyframes scrollLine {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }
</style>
