---
const steps = [
  {
    number: '01',
    title: 'Free Consultation',
    description: 'We visit your space, listen to your vision, and assess the full scope of your project — at no cost and no commitment.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-7 h-7">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
    </svg>`,
  },
  {
    number: '02',
    title: 'Design & Planning',
    description: 'We develop layouts, finishes, and material selections with a transparent budget and timeline — all finalized before construction begins.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-7 h-7">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
    </svg>`,
  },
  {
    number: '03',
    title: 'Expert Construction',
    description: 'Our skilled team builds with precision and care. You receive regular updates and have a single point of contact throughout the entire process.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-7 h-7">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
    </svg>`,
  },
  {
    number: '04',
    title: 'Final Walkthrough',
    description: "We inspect every finish together and resolve every detail before we close the job. Your satisfaction isn't a bonus — it's the standard.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-7 h-7">
      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
    </svg>`,
  },
];
---

<section class="py-24 md:py-32" style="background: #0C0C0C;">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="fade-in mb-20 text-center max-w-2xl mx-auto">
      <p class="section-label mb-4" data-i18n="process.label">How We Work</p>
      <h2
        class="text-4xl md:text-5xl font-light leading-tight"
        style="font-family: 'Playfair Display', serif;"
      >
        <span data-i18n="process.title">A Process Built on</span><br />
        <span class="text-gold italic" data-i18n="process.titleSpan">Clarity & Trust</span>
      </h2>
    </div>

    <!-- Steps -->
    <div class="relative">

      <!-- Connector line (desktop) -->
      <div
        class="hidden lg:block absolute top-[52px] left-0 right-0 h-px"
        style="background: linear-gradient(to right, transparent, #2A2A2A 10%, #2A2A2A 90%, transparent); margin: 0 12.5%;"
      ></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0">
        {steps.map((step, i) => (
          <div
            class="fade-in flex flex-col items-center text-center px-8 py-10 relative group"
            style={`transition-delay: ${i * 0.12}s;`}
          >
            <!-- Circle with number -->
            <div
              class="relative z-10 w-[104px] h-[104px] rounded-full flex items-center justify-center mb-8 transition-all duration-500 group-hover:scale-105"
              style="background: #141414; border: 1px solid #2A2A2A; box-shadow: 0 0 0 8px #0C0C0C;"
            >
              <!-- Gold arc accent -->
              <div
                class="absolute inset-0 rounded-full"
                style="background: conic-gradient(#C9A84C 0deg, #C9A84C 90deg, transparent 90deg); opacity: 0.18; border-radius: 50%;"
              ></div>
              <div class="flex flex-col items-center gap-1">
                <span class="text-gold" set:html={step.icon} />
                <span
                  class="text-xs font-semibold tracking-[0.2em] text-white/30"
                  style="font-family: 'Inter', sans-serif;"
                >
                  {step.number}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="w-8 h-px bg-gold mb-6 mx-auto"></div>
            <h3
              class="text-xl font-semibold mb-3 leading-tight"
              style="font-family: 'Playfair Display', serif;"
              data-i18n={`process.step${i + 1}.title`}
            >
              {step.title}
            </h3>
            <p class="text-white/50 text-sm leading-relaxed" data-i18n={`process.step${i + 1}.desc`}>
              {step.description}
            </p>

            <!-- Mobile connector -->
            {i < steps.length - 1 && (
              <div class="lg:hidden w-px h-10 bg-subtle mt-8 mx-auto" style="background: #2A2A2A;"></div>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
