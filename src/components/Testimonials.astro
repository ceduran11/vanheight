---
const reviews = [
  {
    name: 'Sarah M.',
    location: 'The Woodlands, TX',
    rating: 5,
    text: 'VanHeight completely transformed our kitchen. The craftsmanship is exceptional and they finished ahead of schedule. Our neighbors keep asking who did the work!',
    project: 'Kitchen Remodel',
  },
  {
    name: 'James R.',
    location: 'Spring, TX',
    rating: 5,
    text: 'We hired them for a full bathroom remodel and couldn\'t be happier. Professional from start to finish, transparent pricing, zero surprises. Will definitely use them again.',
    project: 'Bathroom Remodel',
  },
  {
    name: 'Diana L.',
    location: 'Conroe, TX',
    rating: 5,
    text: 'The hardwood floors they installed are absolutely beautiful. The team was respectful of our home, cleaned up every day, and the result exceeded our expectations.',
    project: 'Flooring',
  },
];
---

<section class="py-24 md:py-32" style="background: #141414;">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-16 fade-in text-center max-w-2xl mx-auto">
      <p class="section-label mb-4">Client Reviews</p>
      <h2
        class="text-4xl md:text-5xl font-light leading-tight"
        style="font-family: 'Playfair Display', serif;"
      >
        What Our Clients Say
      </h2>
    </div>

    <!-- Reviews grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background: #2A2A2A;">
      {reviews.map((review, i) => (
        <div
          class="fade-in p-8 flex flex-col gap-6"
          style={`background: #141414; transition-delay: ${i * 0.1}s;`}
        >
          <!-- Stars -->
          <div class="flex gap-1">
            {Array(review.rating).fill(0).map(() => (
              <span class="text-gold text-sm">★</span>
            ))}
          </div>

          <!-- Project badge -->
          <span class="text-xs tracking-widest uppercase font-semibold text-gold/60">
            {review.project}
          </span>

          <!-- Text -->
          <p class="text-white/70 text-sm leading-relaxed flex-grow">
            "{review.text}"
          </p>

          <!-- Author -->
          <div class="border-t border-subtle pt-4">
            <p class="text-white font-semibold text-sm">{review.name}</p>
            <p class="text-muted-custom text-xs mt-0.5">{review.location}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
