---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
];

const reNavLinks = [
  { href: '/real-estate', label: 'Home' },
  { href: '/real-estate/services', label: 'Services' },
  { href: '/real-estate/gallery', label: 'Gallery' },
  { href: '/real-estate/about', label: 'About' },
  { href: '/real-estate/contact', label: 'Contact' },
  { href: '/real-estate/why-houston', label: 'Why Houston?' },
];

const wcNavLinks = [
  { href: '/worldcup2026/live', label: 'Resultados' },
  { href: '/worldcup2026/groups', label: 'Grupos' },
];

const rawPath = Astro.url.pathname;
const currentPath = rawPath.length > 1 ? rawPath.replace(/\/$/, '') : rawPath;
const isRealEstate = currentPath.startsWith('/real-estate');
const isWorldCup = currentPath.startsWith('/worldcup2026');
---

{isRealEstate ? (
  <>
    <!-- ── Real Estate: Vertical Sidebar (desktop) ── -->
    <aside class="re-sidebar">
      <!-- Logo -->
      <a href="/real-estate" class="flex flex-col items-center mb-6">
        <img src="/images/logo-re.png" alt="VanHeight Real Estate" style="height: 80px; width: auto; margin-bottom: -0.75rem;" />
        <div class="text-center">
          <div style="font-family: 'Playfair Display', serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase;">VanHeight</div>
          <div class="flex items-center justify-center gap-2" style="margin-top: -2px;">
            <span style="display:inline-block;width:10px;height:1px;background:#4ade80;"></span>
            <span style="font-family:'Playfair Display',serif;font-size:0.55rem;letter-spacing:0.28em;color:#4ade80;text-transform:uppercase;">Real Estate</span>
            <span style="display:inline-block;width:10px;height:1px;background:#4ade80;"></span>
          </div>
        </div>
      </a>

      <!-- Divider -->
      <div style="width:100%;height:1px;background:#1a1a1a;margin-bottom:1.5rem;"></div>

      <!-- Nav links -->
      <nav class="flex flex-col gap-1 flex-1">
        {reNavLinks.map((link) => (
          <a
            href={link.href}
            class={`re-sidebar-link ${currentPath === link.href ? 'active' : ''}`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Bottom -->
      <div class="flex flex-col gap-3 mt-6 pt-6" style="border-top:1px solid #1a1a1a;">
        <p class="text-center" style="font-size:0.6rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.3);">
          Vuelve a
        </p>
        <a href="/" class="remodeling-logo-link flex flex-col items-center leading-none">
          <span style="font-family: 'Playfair Display', serif; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase;">VanHeight</span>
          <span class="flex items-center gap-2 mt-1">
            <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
            <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
            <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
          </span>
        </a>
        <a href="tel:+18323069934" class="text-center text-xs tracking-wider" style="color:rgba(255,255,255,0.35);">
          (832) 306-9934
        </a>
        <!-- Language toggle -->
        <div class="flex items-center justify-center gap-3 pt-1">
          <button data-lang="en" class="lang-option text-xs tracking-widest uppercase transition-colors" style="color:rgba(255,255,255,0.4);" onmouseover="this.style.color='#4ade80'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">EN</button>
          <span style="color:rgba(255,255,255,0.15);font-size:0.6rem;">|</span>
          <button data-lang="es" class="lang-option text-xs tracking-widest uppercase transition-colors" style="color:rgba(255,255,255,0.4);" onmouseover="this.style.color='#4ade80'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">ES</button>
          <span style="color:rgba(255,255,255,0.15);font-size:0.6rem;">|</span>
          <button data-lang="pt" class="lang-option text-xs tracking-widest uppercase transition-colors" style="color:rgba(255,255,255,0.4);" onmouseover="this.style.color='#4ade80'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">PT</button>
        </div>
      </div>
    </aside>

    <!-- ── Real Estate: Mobile top bar ── -->
    <div class="re-mobile-top fixed top-0 left-0 right-0 z-50 px-4 items-center justify-between" style="background:rgba(12,12,12,0.97);border-bottom:1px solid #1a1a1a;height:64px;">
      <a href="/real-estate" class="flex items-center gap-3">
        <img src="/images/logo-re.png" alt="VanHeight Real Estate" style="height:44px;width:auto;" />
        <div>
          <div style="font-family:'Playfair Display',serif;font-size:0.8rem;font-weight:700;letter-spacing:0.15em;color:#F5F5F5;text-transform:uppercase;line-height:1.1;">VanHeight</div>
          <div style="font-size:0.5rem;letter-spacing:0.25em;color:#4ade80;text-transform:uppercase;">Real Estate</div>
        </div>
      </a>
      <button id="re-menu-btn" class="flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
        <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="re-line1"></span>
        <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="re-line2"></span>
        <span class="w-4 h-0.5 bg-white transition-all duration-300 block" id="re-line3"></span>
      </button>
    </div>

    <!-- Mobile drawer -->
    <div id="re-drawer" class="fixed inset-0 z-[100] hidden" style="background:rgba(0,0,0,0.7);">
      <div id="re-drawer-panel" class="absolute left-0 top-0 h-full flex flex-col py-8 px-6" style="width:260px;background:#0C0C0C;border-right:1px solid #1a1a1a;">
        <a href="/real-estate" class="flex flex-col items-center mb-8">
          <img src="/images/logo-re.png" alt="VanHeight Real Estate" style="height:60px;" />
        </a>
        <div style="width:100%;height:1px;background:#1a1a1a;margin-bottom:1.5rem;"></div>
        <nav class="flex flex-col gap-1 flex-1">
          {reNavLinks.map((link) => (
            <a
              href={link.href}
              class={`re-sidebar-link ${currentPath === link.href ? 'active' : ''}`}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <div class="flex flex-col gap-3 pt-6" style="border-top:1px solid #1a1a1a;">
          <p class="text-center" style="font-size:0.6rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.3);">
            Vuelve a
          </p>
          <a href="/" class="remodeling-logo-link flex flex-col items-center leading-none">
            <span style="font-family: 'Playfair Display', serif; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase;">VanHeight</span>
            <span class="flex items-center gap-2 mt-1">
              <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
              <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
              <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
            </span>
          </a>
          <a href="tel:+18323069934" class="text-center text-xs tracking-wider" style="color:rgba(255,255,255,0.35);">
            (832) 306-9934
          </a>
          <!-- Language toggle -->
          <div class="flex items-center justify-center gap-3 pt-1">
            <button data-lang="en" class="lang-option text-xs tracking-widest uppercase transition-colors" style="color:rgba(255,255,255,0.4);">EN</button>
            <span style="color:rgba(255,255,255,0.15);font-size:0.6rem;">|</span>
            <button data-lang="es" class="lang-option text-xs tracking-widest uppercase transition-colors" style="color:rgba(255,255,255,0.4);">ES</button>
            <span style="color:rgba(255,255,255,0.15);font-size:0.6rem;">|</span>
            <button data-lang="pt" class="lang-option text-xs tracking-widest uppercase transition-colors" style="color:rgba(255,255,255,0.4);">PT</button>
          </div>
        </div>
      </div>
    </div>
  </>
) : isWorldCup ? (
  <>
    <!-- ── World Cup: Vertical Sidebar (desktop) ── -->
    <aside class="wc-sidebar">
      <!-- Logo -->
      <a href="/worldcup2026/live" class="flex flex-col items-center mb-6">
        <img src="/images/wc-logo.png" alt="World Cup 2026" style="width:184px;height:184px;object-fit:contain;margin-bottom:-3.0rem;" />
        <div class="text-center" style="margin-top:0;">
          <div style="font-family: 'Playfair Display', serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase;">VanHeight</div>
          <div class="flex items-center justify-center gap-2" style="margin-top:-0.15rem;">
            <span style="display:inline-block;width:10px;height:1px;background:#00A859;"></span>
            <span style="font-family:'Playfair Display',serif;font-size:0.55rem;letter-spacing:0.2em;color:#00A859;text-transform:uppercase;">World Cup 2026</span>
            <span style="display:inline-block;width:10px;height:1px;background:#00A859;"></span>
          </div>
        </div>
      </a>

      <!-- Divider -->
      <div style="width:100%;height:1px;background:#14315c;margin-bottom:1.5rem;"></div>

      <!-- Nav links -->
      <nav class="flex flex-col gap-1 flex-1">
        {wcNavLinks.map((link) => (
          <a
            href={link.href}
            class={`wc-sidebar-link flex items-center gap-2 ${currentPath === link.href ? 'active' : ''}`}
          >
            {link.label}
            {link.href === '/worldcup2026/live' && (
              <span class="wc-live-badge wc-live-badge--dim">
                <span class="wc-live-dot"></span>VIVO
              </span>
            )}
          </a>
        ))}
      </nav>

      <!-- Bottom -->
      <div class="flex flex-col gap-3 mt-6 pt-6" style="border-top:1px solid #14315c;">
        <p class="text-center" style="font-size:0.6rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.3);">
          Vuelve a
        </p>
        <a href="/" class="remodeling-logo-link flex flex-col items-center leading-none">
          <span style="font-family: 'Playfair Display', serif; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase;">VanHeight</span>
          <span class="flex items-center gap-2 mt-1">
            <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
            <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
            <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
          </span>
        </a>
        <a href="tel:+18323069934" class="text-center text-xs tracking-wider" style="color:rgba(255,255,255,0.35);">
          (832) 306-9934
        </a>
      </div>
    </aside>

    <!-- ── World Cup: Mobile top bar ── -->
    <div class="wc-mobile-top fixed top-0 left-0 right-0 z-50 px-4 items-center justify-between" style="background:rgba(11,31,58,0.97);border-bottom:1px solid #14315c;height:64px;">
      <a href="/worldcup2026/live" class="flex items-center">
        <img src="/images/wc-logo.png" alt="World Cup 2026" style="width:100px;height:100px;object-fit:contain;flex-shrink:0;margin-right:-2.0rem;" />
        <div>
          <div style="font-family:'Playfair Display',serif;font-size:0.8rem;font-weight:700;letter-spacing:0.15em;color:#F5F5F5;text-transform:uppercase;line-height:1.1;">VanHeight</div>
          <div style="font-size:0.45rem;letter-spacing:0.2em;color:#00A859;text-transform:uppercase;">World Cup 2026</div>
        </div>
      </a>
      <button id="wc-menu-btn" class="flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
        <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="wc-line1"></span>
        <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="wc-line2"></span>
        <span class="w-4 h-0.5 bg-white transition-all duration-300 block" id="wc-line3"></span>
      </button>
    </div>

    <!-- Mobile drawer -->
    <div id="wc-drawer" class="fixed inset-0 z-[100] hidden" style="background:rgba(0,0,0,0.7);">
      <div id="wc-drawer-panel" class="absolute left-0 top-0 h-full flex flex-col py-8 px-6" style="width:260px;background:#0B1F3A;border-right:1px solid #14315c;">
        <a href="/worldcup2026/live" class="flex flex-col items-center mb-8">
          <img src="/images/wc-logo.png" alt="World Cup 2026" style="width:160px;height:160px;object-fit:contain;" />
        </a>
        <div style="width:100%;height:1px;background:#14315c;margin-bottom:1.5rem;"></div>
        <nav class="flex flex-col gap-1 flex-1">
          {wcNavLinks.map((link) => (
            <a
              href={link.href}
              class={`wc-sidebar-link flex items-center gap-2 ${currentPath === link.href ? 'active' : ''}`}
            >
              {link.label}
              {link.href === '/worldcup2026/live' && (
                <span class="wc-live-badge wc-live-badge--dim">
                  <span class="wc-live-dot"></span>VIVO
                </span>
              )}
            </a>
          ))}
        </nav>
        <div class="flex flex-col gap-3 pt-6" style="border-top:1px solid #14315c;">
          <p class="text-center" style="font-size:0.6rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.3);">
            Vuelve a
          </p>
          <a href="/" class="remodeling-logo-link flex flex-col items-center leading-none">
            <span style="font-family: 'Playfair Display', serif; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase;">VanHeight</span>
            <span class="flex items-center gap-2 mt-1">
              <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
              <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
              <span style="display: inline-block; width: 14px; height: 1px; background: #C9A84C;"></span>
            </span>
          </a>
          <a href="tel:+18323069934" class="text-center text-xs tracking-wider" style="color:rgba(255,255,255,0.35);">
            (832) 306-9934
          </a>
        </div>
      </div>
    </div>
  </>
) : (
  <header
    id="header"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    style="background: transparent;"
  >
    <div class="max-w-7xl mx-auto px-6 py-3" style="display: grid; grid-template-columns: auto auto 1fr; align-items: center; column-gap: 2.5rem;">

      <!-- Logo (left) -->
      <a href="/" class="logo-link flex items-center" style="gap: 0px;">
        <img src="/images/logo.png" alt="VanHeight" style="height: 100px; width: auto; display: block; flex-shrink: 0;" />
        <div class="logo-text flex flex-col leading-none">
          <span style="font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase; line-height: 1.1;">VanHeight</span>
          <span class="flex items-center gap-2 mt-1">
            <span style="display: inline-block; width: 16px; height: 1px; background: #C9A84C;"></span>
            <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
            <span style="display: inline-block; width: 16px; height: 1px; background: #C9A84C;"></span>
          </span>
        </div>
      </a>

      <!-- Desktop Nav (center) -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`nav-link text-sm tracking-widest uppercase transition-colors ${
              currentPath === link.href ? 'text-gold nav-link--active' : 'text-white/70 hover:text-white'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a
          href="/worldcup2026/live"
          class="world-cup-link flex items-center transition-all duration-300"
        >
          <img src="/images/logo world cup.png" alt="World Cup" style="height:70px;width:auto;object-fit:contain;" />
        </a>
      </nav>

      <!-- CTA + Language Toggle (right) -->
      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.6rem;">
        <a
          href="/real-estate"
          class="real-estate-link hidden md:flex text-xs tracking-widest uppercase font-semibold px-3 py-1.5 transition-all duration-300"
          style="border: 1px solid #4ade80; color: #4ade80; text-shadow: 0 0 8px rgba(74,222,128,0.6); white-space: nowrap;"
          data-i18n="nav.realEstate"
        >
          Real Estate
        </a>
        <div class="hidden md:flex flex-col items-center" style="gap: 3px;">
          <a href="tel:+18323069934" class="text-sm text-white hover:text-gold transition-colors">(832) 306-9934</a>
          <div class="flex items-center gap-2">
            <a href="https://www.facebook.com/vanheight.cons/" target="_blank" rel="noopener" aria-label="Facebook" class="flex items-center justify-center transition-opacity hover:opacity-70" style="width:16px;height:16px;background:#fff;border-radius:50%;">
              <img src="/images/face.png" alt="Facebook" class="w-3.5 h-3.5" style="object-fit:contain;" />
            </a>
            <a href="#" target="_blank" rel="noopener" aria-label="Instagram" class="flex items-center justify-center transition-opacity hover:opacity-70" style="width:16px;height:16px;background:#fff;border-radius:4px;">
              <img src="/images/insta.png" alt="Instagram" class="w-3.5 h-3.5" style="object-fit:contain;" />
            </a>
          </div>
        </div>
        <div class="hidden md:flex items-center gap-4 relative" id="lang-dropdown-wrapper">
          <button id="lang-toggle" class="flex items-center gap-1.5 text-xs text-white hover:text-gold transition-colors font-medium tracking-widest uppercase px-3 py-2 border border-transparent hover:border-gold/30">
            <span id="lang-text">EN</span>
            <svg id="lang-chevron" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="lang-menu" class="hidden absolute top-full right-0 mt-1 border border-subtle flex-col" style="background: #141414; min-width: 80px; z-index: 100;">
            <button data-lang="en" class="lang-option text-xs tracking-widest uppercase px-4 py-3 text-left text-white hover:text-gold hover:bg-white/5 transition-colors">EN</button>
            <button data-lang="es" class="lang-option text-xs tracking-widest uppercase px-4 py-3 text-left text-white hover:text-gold hover:bg-white/5 transition-colors border-t border-subtle">ES</button>
            <button data-lang="pt" class="lang-option text-xs tracking-widest uppercase px-4 py-3 text-left text-white hover:text-gold hover:bg-white/5 transition-colors border-t border-subtle">PT</button>
          </div>
        </div>
        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
          <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="line1"></span>
          <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="line2"></span>
          <span class="w-4 h-0.5 bg-white transition-all duration-300 block" id="line3"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden flex-col gap-0 border-t border-subtle" style="background: #0C0C0C;">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-link px-6 py-4 text-sm tracking-widest uppercase font-medium text-white/70 border-b border-subtle">
          {link.label}
        </a>
      ))}
      <a href="/real-estate" class="mobile-link px-6 py-4 text-sm tracking-widest uppercase font-semibold border-b border-subtle" style="color: #4ade80; text-shadow: 0 0 8px rgba(74,222,128,0.6);" data-i18n="nav.realEstate">
        Real Estate
      </a>
      <a href="/worldcup2026/live" class="mobile-link px-6 py-4 flex items-center border-b border-subtle">
        <img src="/images/logo world cup.png" alt="World Cup" style="height:72px;width:auto;object-fit:contain;" />
      </a>
      <div class="px-6 py-5 flex flex-col gap-3">
        <a href="tel:+18323069934" class="text-sm text-muted-custom">(832) 306-9934</a>
        <a href="/contact" class="btn-gold" style="font-size: 0.75rem; padding: 0.75rem 1.5rem; text-align: center;">Free Quote</a>
      </div>
    </div>
  </header>
)}

<style>
  /* Logo layout */
  .logo-link {
    flex-direction: column;
    align-items: flex-start;
    margin-left: -24px;
  }
  .logo-text {
    margin-left: 8px;
    margin-top: -8px;
  }
  @media (min-width: 1024px) {
    .logo-link {
      flex-direction: row;
      align-items: center;
    }
    .logo-text {
      margin-left: -28px;
      margin-top: 0;
    }
  }

  .real-estate-link:hover {
    background: #4ade80 !important;
    color: #000 !important;
    text-shadow: none !important;
    box-shadow: 0 0 16px rgba(74,222,128,0.5);
  }

  .world-cup-link:hover {
    filter: drop-shadow(0 0 10px rgba(255,199,44,0.7));
    transform: scale(1.05);
  }

  .remodeling-logo-link {
    transition: opacity 0.25s ease;
  }
  .remodeling-logo-link:hover {
    opacity: 0.7;
  }

  .nav-link {
    font-weight: 500;
    padding-bottom: 3px;
    border-bottom: 1.5px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .nav-link:hover {
    border-bottom-color: #C9A84C;
  }
  .nav-link--active {
    font-weight: 600;
    border-bottom-color: #C9A84C;
  }

  /* Real Estate nav — green active/hover */
  .re-nav-link:hover {
    color: #4ade80;
    border-bottom-color: #4ade80;
  }
  .re-nav-link--active {
    color: #4ade80;
    font-weight: 600;
    border-bottom-color: #4ade80;
  }

  .mobile-link {
    transition: color 0.2s ease, padding-left 0.2s ease, background-color 0.2s ease;
  }
  .mobile-link:hover {
    color: #C9A84C;
    padding-left: 28px;
    background-color: rgba(255,255,255,0.03);
  }

  .wc-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 999px;
    padding: 2px 6px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .wc-live-badge--dim {
    color: rgba(255,255,255,0.3);
    border: 1px solid rgba(255,255,255,0.2);
  }
  .wc-live-badge--on {
    color: #E0483E;
    border: 1px solid #E0483E;
  }
  .wc-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .wc-live-badge--on .wc-live-dot {
    animation: wcLiveBlink 1.2s ease-in-out infinite;
  }
  @keyframes wcLiveBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
</style>

<script>
  const header = document.getElementById('header') as HTMLElement;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('line1');
  const line2 = document.getElementById('line2');
  const line3 = document.getElementById('line3');
  const langToggle = document.getElementById('lang-toggle');
  const langText = document.getElementById('lang-text');
  const langMenu = document.getElementById('lang-menu');
  const langChevron = document.getElementById('lang-chevron');
  const langOptions = document.querySelectorAll<HTMLButtonElement>('.lang-option');

  let currentLang = (localStorage.getItem('language') || 'en') as 'en' | 'es' | 'pt';
  if (langText) langText.textContent = currentLang.toUpperCase();

  // Toggle dropdown open/close
  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !langMenu?.classList.contains('hidden');
    langMenu?.classList.toggle('hidden', isOpen);
    langMenu?.classList.toggle('flex', !isOpen);
    langMenu?.classList.toggle('flex-col', !isOpen);
    if (langChevron) langChevron.style.transform = isOpen ? '' : 'rotate(180deg)';
  });

  // Select language
  langOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentLang = btn.dataset.lang as 'en' | 'es' | 'pt';
      localStorage.setItem('language', currentLang);
      if (langText) langText.textContent = currentLang.toUpperCase();
      langMenu?.classList.add('hidden');
      langMenu?.classList.remove('flex', 'flex-col');
      if (langChevron) langChevron.style.transform = '';
      window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang: currentLang } }));
    });
  });

  // Close dropdown on outside click
  document.addEventListener('click', () => {
    langMenu?.classList.add('hidden');
    langMenu?.classList.remove('flex', 'flex-col');
    if (langChevron) langChevron.style.transform = '';
  });

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 5) {
      header.style.background = 'rgba(12,12,12,0.97)';
      header.style.borderBottom = '1px solid #000000';
      header.style.backdropFilter = 'blur(10px)';
    } else {
      header.style.background = 'transparent';
      header.style.borderBottom = 'none';
      header.style.backdropFilter = 'none';
    }
  });

  // Mobile toggle (VanHeight)
  let menuOpen = false;
  mobileMenuBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('hidden', !menuOpen);
    mobileMenu?.classList.toggle('flex', menuOpen);
    if (line1) line1.style.transform = menuOpen ? 'translateY(8px) rotate(45deg)' : '';
    if (line2) line2.style.opacity = menuOpen ? '0' : '1';
    if (line3) {
      line3.style.transform = menuOpen ? 'translateY(-8px) rotate(-45deg)' : '';
      line3.style.width = menuOpen ? '24px' : '16px';
    }
  });

  // Real Estate mobile drawer
  const reMenuBtn = document.getElementById('re-menu-btn');
  const reDrawer = document.getElementById('re-drawer');
  const reDrawerPanel = document.getElementById('re-drawer-panel');
  const reLine1 = document.getElementById('re-line1');
  const reLine2 = document.getElementById('re-line2');
  const reLine3 = document.getElementById('re-line3');

  let reMenuOpen = false;
  reMenuBtn?.addEventListener('click', () => {
    reMenuOpen = !reMenuOpen;
    reDrawer?.classList.toggle('hidden', !reMenuOpen);
    if (reLine1) reLine1.style.transform = reMenuOpen ? 'translateY(8px) rotate(45deg)' : '';
    if (reLine2) reLine2.style.opacity = reMenuOpen ? '0' : '1';
    if (reLine3) {
      reLine3.style.transform = reMenuOpen ? 'translateY(-8px) rotate(-45deg)' : '';
      reLine3.style.width = reMenuOpen ? '24px' : '16px';
    }
  });

  // Close drawer when clicking outside the panel
  reDrawer?.addEventListener('click', (e) => {
    if (!reDrawerPanel?.contains(e.target as Node)) {
      reMenuOpen = false;
      reDrawer.classList.add('hidden');
      if (reLine1) reLine1.style.transform = '';
      if (reLine2) reLine2.style.opacity = '1';
      if (reLine3) { reLine3.style.transform = ''; reLine3.style.width = '16px'; }
    }
  });

  // World Cup mobile drawer
  const wcMenuBtn = document.getElementById('wc-menu-btn');
  const wcDrawer = document.getElementById('wc-drawer');
  const wcDrawerPanel = document.getElementById('wc-drawer-panel');
  const wcLine1 = document.getElementById('wc-line1');
  const wcLine2 = document.getElementById('wc-line2');
  const wcLine3 = document.getElementById('wc-line3');

  let wcMenuOpen = false;
  wcMenuBtn?.addEventListener('click', () => {
    wcMenuOpen = !wcMenuOpen;
    wcDrawer?.classList.toggle('hidden', !wcMenuOpen);
    if (wcLine1) wcLine1.style.transform = wcMenuOpen ? 'translateY(8px) rotate(45deg)' : '';
    if (wcLine2) wcLine2.style.opacity = wcMenuOpen ? '0' : '1';
    if (wcLine3) {
      wcLine3.style.transform = wcMenuOpen ? 'translateY(-8px) rotate(-45deg)' : '';
      wcLine3.style.width = wcMenuOpen ? '24px' : '16px';
    }
  });

  // Close drawer when clicking outside the panel
  wcDrawer?.addEventListener('click', (e) => {
    if (!wcDrawerPanel?.contains(e.target as Node)) {
      wcMenuOpen = false;
      wcDrawer.classList.add('hidden');
      if (wcLine1) wcLine1.style.transform = '';
      if (wcLine2) wcLine2.style.opacity = '1';
      if (wcLine3) { wcLine3.style.transform = ''; wcLine3.style.width = '16px'; }
    }
  });

  // "VIVO" badge next to Resultados — only lights up if a match is live right now
  const wcLiveBadges = document.querySelectorAll<HTMLElement>('.wc-live-badge');
  if (wcLiveBadges.length > 0) {
    async function fetchIsLiveOnce(): Promise<boolean> {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 12000);
      try {
        const res = await fetch('https://worldcup26.ir/get/games', { signal: controller.signal });
        const data = await res.json();
        if (!Array.isArray(data?.games)) throw new Error('bad payload');
        return data.games.some((g: any) => (g.time_elapsed || '').toLowerCase() === 'live');
      } finally {
        clearTimeout(timer);
      }
    }

    async function checkLiveNow() {
      // worldcup26.ir fails a meaningful fraction of single requests — retry
      // a few times before settling for "dim" this cycle.
      const maxAttempts = 7;
      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
          const isLive = await fetchIsLiveOnce();
          wcLiveBadges.forEach((el) => {
            el.classList.toggle('wc-live-badge--on', isLive);
            el.classList.toggle('wc-live-badge--dim', !isLive);
          });
          return;
        } catch {
          if (attempt < maxAttempts) await new Promise((r) => setTimeout(r, 1500));
        }
      }
      // All attempts failed — leave badge in its current/dim state.
    }
    checkLiveNow();
    setInterval(checkLiveNow, 2 * 60 * 1000);
  }
</script>
