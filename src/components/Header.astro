---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
];

const reNavLinks = [
  { href: '/real-estate', label: 'Home' },
  { href: '/real-estate/services', label: 'Services' },
  { href: '/real-estate/gallery', label: 'Gallery' },
  { href: '/real-estate/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isRealEstate = currentPath.startsWith('/real-estate');
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="background: transparent;"
>
  <div class="max-w-7xl mx-auto px-6 py-3" style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;">

    <!-- Logo (left) -->
    <a href={isRealEstate ? '/real-estate' : '/'} class="logo-link flex items-center" style="gap: 0px;">
      {isRealEstate ? (
        <>
          <img
            src="/images/logo-re.png"
            alt="VanHeight Real Estate"
            style="height: 100px; width: auto; display: block; flex-shrink: 0;"
          />
          <div class="logo-text flex flex-col leading-none">
            <span style="font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase; line-height: 1.1;">VanHeight</span>
            <span class="flex items-center gap-2 mt-1">
              <span style="display: inline-block; width: 16px; height: 1px; background: #4ade80;"></span>
              <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #4ade80; text-transform: uppercase;">Real Estate</span>
              <span style="display: inline-block; width: 16px; height: 1px; background: #4ade80;"></span>
            </span>
          </div>
        </>
      ) : (
        <>
          <img
            src="/images/logo.png"
            alt="VanHeight"
            style="height: 100px; width: auto; display: block; flex-shrink: 0;"
          />
          <div class="logo-text flex flex-col leading-none">
            <span style="font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; letter-spacing: 0.15em; color: #F5F5F5; text-transform: uppercase; line-height: 1.1;">VanHeight</span>
            <span class="flex items-center gap-2 mt-1">
              <span style="display: inline-block; width: 16px; height: 1px; background: #C9A84C;"></span>
              <span style="font-family: 'Playfair Display', serif; font-size: 0.55rem; font-weight: 400; letter-spacing: 0.28em; color: #C9A84C; text-transform: uppercase;">Remodeling</span>
              <span style="display: inline-block; width: 16px; height: 1px; background: #C9A84C;"></span>
            </span>
          </div>
        </>
      )}
    </a>

    <!-- Desktop Nav (center) -->
    <nav class="hidden md:flex items-center gap-8">
      {isRealEstate ? (
        <>
          {reNavLinks.map((link) => (
            <a
              href={link.href}
              class={`nav-link re-nav-link text-sm tracking-widest uppercase transition-colors ${
                currentPath === link.href
                  ? 're-nav-link--active'
                  : 'text-white/70'
              }`}
            >
              {link.label}
            </a>
          ))}
          <a
            href="/"
            class="remodeling-link text-xs tracking-widest uppercase font-semibold px-4 py-1.5 transition-all duration-300"
            style="border: 1px solid #C9A84C; color: #C9A84C;"
          >
            Remodeling
          </a>
        </>
      ) : (
        <>
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`nav-link text-sm tracking-widest uppercase transition-colors ${
                currentPath === link.href
                  ? 'text-gold nav-link--active'
                  : 'text-white/70 hover:text-white'
              }`}
            >
              {link.label}
            </a>
          ))}
          <a
            href="/real-estate"
            class="real-estate-link text-xs tracking-widest uppercase font-semibold px-4 py-1.5 transition-all duration-300"
            style="border: 1px solid #4ade80; color: #4ade80; text-shadow: 0 0 8px rgba(74,222,128,0.6);"
            data-i18n="nav.realEstate"
          >
            Real Estate
          </a>
        </>
      )}
    </nav>

    <!-- CTA + Language Toggle (right) -->
    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 1rem;">
      <a href="https://www.facebook.com/vanheight.cons/" target="_blank" rel="noopener" aria-label="Facebook" class="hidden md:flex text-white/60 hover:text-gold transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
      </a>
      <a href="#" target="_blank" rel="noopener" aria-label="Instagram" class="hidden md:flex text-white/60 hover:text-gold transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/></svg>
      </a>
      <a href="tel:+18323069934" class="text-sm text-white hover:text-gold transition-colors">
        (832) 306-9934
      </a>
      <div class="hidden md:flex items-center gap-4 relative" id="lang-dropdown-wrapper">
        <button
          id="lang-toggle"
          class="flex items-center gap-1.5 text-xs text-white hover:text-gold transition-colors font-medium tracking-widest uppercase px-3 py-2 border border-transparent hover:border-gold/30"
        >
          <span id="lang-text">EN</span>
          <svg id="lang-chevron" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="lang-menu"
          class="hidden absolute top-full right-0 mt-1 border border-subtle flex-col"
          style="background: #141414; min-width: 80px; z-index: 100;"
        >
          <button data-lang="en" class="lang-option text-xs tracking-widest uppercase px-4 py-3 text-left text-white hover:text-gold hover:bg-white/5 transition-colors">EN</button>
          <button data-lang="es" class="lang-option text-xs tracking-widest uppercase px-4 py-3 text-left text-white hover:text-gold hover:bg-white/5 transition-colors border-t border-subtle">ES</button>
          <button data-lang="pt" class="lang-option text-xs tracking-widest uppercase px-4 py-3 text-left text-white hover:text-gold hover:bg-white/5 transition-colors border-t border-subtle">PT</button>
        </div>
      </div>
      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex flex-col gap-1.5 p-2"
        aria-label="Toggle menu"
      >
        <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="line1"></span>
        <span class="w-6 h-0.5 bg-white transition-all duration-300 block" id="line2"></span>
        <span class="w-4 h-0.5 bg-white transition-all duration-300 block" id="line3"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-0 border-t border-subtle"
    style="background: #0C0C0C;"
  >
    {isRealEstate ? (
      <>
        {reNavLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-link px-6 py-4 text-sm tracking-widest uppercase font-medium border-b border-subtle"
            style={currentPath === link.href ? 'color: #4ade80;' : 'color: rgba(255,255,255,0.7);'}
          >
            {link.label}
          </a>
        ))}
        <a href="/" class="mobile-link px-6 py-4 text-sm tracking-widest uppercase font-semibold border-b border-subtle" style="color: #C9A84C;">
          Remodeling
        </a>
      </>
    ) : (
      <>
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-link px-6 py-4 text-sm tracking-widest uppercase font-medium text-white/70 border-b border-subtle"
          >
            {link.label}
          </a>
        ))}
        <a href="/real-estate" class="mobile-link px-6 py-4 text-sm tracking-widest uppercase font-semibold border-b border-subtle" style="color: #4ade80; text-shadow: 0 0 8px rgba(74,222,128,0.6);" data-i18n="nav.realEstate">
          Real Estate
        </a>
      </>
    )}
    <div class="px-6 py-5 flex flex-col gap-3">
      <a href="tel:+18323069934" class="text-sm text-muted-custom">
        (832) 306-9934
      </a>
      {!isRealEstate && (
        <a href="/contact" class="btn-gold" style="font-size: 0.75rem; padding: 0.75rem 1.5rem; text-align: center;">
          Free Quote
        </a>
      )}
    </div>
  </div>
</header>

<style>
  /* Logo layout */
  .logo-link {
    flex-direction: column;
    align-items: flex-start;
  }
  .logo-text {
    margin-left: 8px;
    margin-top: -8px;
  }
  @media (min-width: 1024px) {
    .logo-link {
      flex-direction: row;
      align-items: center;
    }
    .logo-text {
      margin-left: -28px;
      margin-top: 0;
    }
  }

  .real-estate-link:hover {
    background: #4ade80 !important;
    color: #000 !important;
    text-shadow: none !important;
    box-shadow: 0 0 16px rgba(74,222,128,0.5);
  }

  .remodeling-link:hover {
    background: #C9A84C !important;
    color: #000 !important;
    text-shadow: none !important;
    box-shadow: 0 0 16px rgba(201,168,76,0.4);
  }

  .nav-link {
    font-weight: 500;
    padding-bottom: 3px;
    border-bottom: 1.5px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .nav-link:hover {
    border-bottom-color: #C9A84C;
  }
  .nav-link--active {
    font-weight: 600;
    border-bottom-color: #C9A84C;
  }

  /* Real Estate nav — green active/hover */
  .re-nav-link:hover {
    color: #4ade80;
    border-bottom-color: #4ade80;
  }
  .re-nav-link--active {
    color: #4ade80;
    font-weight: 600;
    border-bottom-color: #4ade80;
  }

  .mobile-link {
    transition: color 0.2s ease, padding-left 0.2s ease, background-color 0.2s ease;
  }
  .mobile-link:hover {
    color: #C9A84C;
    padding-left: 28px;
    background-color: rgba(255,255,255,0.03);
  }
</style>

<script>
  const header = document.getElementById('header') as HTMLElement;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('line1');
  const line2 = document.getElementById('line2');
  const line3 = document.getElementById('line3');
  const langToggle = document.getElementById('lang-toggle');
  const langText = document.getElementById('lang-text');
  const langMenu = document.getElementById('lang-menu');
  const langChevron = document.getElementById('lang-chevron');
  const langOptions = document.querySelectorAll<HTMLButtonElement>('.lang-option');

  let currentLang = (localStorage.getItem('language') || 'en') as 'en' | 'es' | 'pt';
  if (langText) langText.textContent = currentLang.toUpperCase();

  // Toggle dropdown open/close
  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !langMenu?.classList.contains('hidden');
    langMenu?.classList.toggle('hidden', isOpen);
    langMenu?.classList.toggle('flex', !isOpen);
    langMenu?.classList.toggle('flex-col', !isOpen);
    if (langChevron) langChevron.style.transform = isOpen ? '' : 'rotate(180deg)';
  });

  // Select language
  langOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentLang = btn.dataset.lang as 'en' | 'es' | 'pt';
      localStorage.setItem('language', currentLang);
      if (langText) langText.textContent = currentLang.toUpperCase();
      langMenu?.classList.add('hidden');
      langMenu?.classList.remove('flex', 'flex-col');
      if (langChevron) langChevron.style.transform = '';
      window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang: currentLang } }));
    });
  });

  // Close dropdown on outside click
  document.addEventListener('click', () => {
    langMenu?.classList.add('hidden');
    langMenu?.classList.remove('flex', 'flex-col');
    if (langChevron) langChevron.style.transform = '';
  });

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 5) {
      header.style.background = 'rgba(12,12,12,0.97)';
      header.style.borderBottom = '1px solid #000000';
      header.style.backdropFilter = 'blur(10px)';
    } else {
      header.style.background = 'transparent';
      header.style.borderBottom = 'none';
      header.style.backdropFilter = 'none';
    }
  });

  // Mobile toggle
  let menuOpen = false;
  mobileMenuBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('hidden', !menuOpen);
    mobileMenu?.classList.toggle('flex', menuOpen);
    if (line1) line1.style.transform = menuOpen ? 'translateY(8px) rotate(45deg)' : '';
    if (line2) line2.style.opacity = menuOpen ? '0' : '1';
    if (line3) {
      line3.style.transform = menuOpen ? 'translateY(-8px) rotate(-45deg)' : '';
      line3.style.width = menuOpen ? '24px' : '16px';
    }
  });
</script>
