---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'VanHeight – Premium home remodeling in The Woodlands, TX. Kitchens, bathrooms, flooring, painting, additions & carpentry.',
