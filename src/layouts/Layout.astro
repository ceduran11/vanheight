      function getVal(obj: Record<string, any>, path: string): string | null {
        return path.split('.').reduce((o: any, k: string) => (o && o[k] !== undefined ? o[k] : null), obj);
      }

      function applyTranslations(lang: string) {
        const d = (t as Record<string, any>)[lang] || t.en;
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n') ?? '';
          const val = getVal(d, key);
          if (val) el.textContent = val;
        });
      }

      // Language switcher — apply without reload
      window.addEventListener('languageChange', (e) => {
        const lang = (e as CustomEvent).detail.lang;
        localStorage.setItem('language', lang);
        document.documentElement.lang = lang;
        document.documentElement.setAttribute('data-lang', lang);
        applyTranslations(lang);
      });

      // Set initial language attribute
      const savedLang = localStorage.getItem('language') || 'en';
      document.documentElement.lang = savedLang;
      document.documentElement.setAttribute('data-lang', savedLang);
      applyTranslations(savedLang);
    </script>
